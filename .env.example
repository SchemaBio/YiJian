# YiJian standalone development configuration.
# Production deployments use Squid/deploy or Octopus/deploy.

NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_BACKEND=octopus
NEXT_PUBLIC_SUPPORT_EMAIL=support@schemabio.com
NEXT_PUBLIC_PASSWORD_HASH_ENABLED=false
NEXT_PUBLIC_PRIVACY_CONSENT_REQUIRED=true
NEXT_PUBLIC_DEV_MOCK_AUTH=false

# Docker runtime settings. YIJIAN_BACKEND is octopus or squid.
YIJIAN_API_URL=/api
YIJIAN_BACKEND=octopus
YIJIAN_SUPPORT_EMAIL=support@schemabio.com
YIJIAN_UPLOAD_ORIGINS=

PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
