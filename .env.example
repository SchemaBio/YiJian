# YiJian frontend environment
# Copy to .env.local for local development, or pass to the Docker container.

# Runtime browser-visible Squid API base URL.
# Use /api when a reverse proxy routes /api to Squid.
YIJIAN_API_URL=/api

# Local Next.js dev fallback. Docker runtime uses YIJIAN_API_URL.
NEXT_PUBLIC_API_URL=/api

# Must match Squid CLIENT_PASSWORD_HASH_ENABLED.
NEXT_PUBLIC_PASSWORD_HASH_ENABLED=false

# Set to "false" to skip the privacy consent checkbox on the login page.
# Default: true (privacy consent required).
NEXT_PUBLIC_PRIVACY_CONSENT_REQUIRED=true

# Set to "true" to enable mock login for local development (no backend required).
# Any email/password combination will work.
NEXT_PUBLIC_DEV_MOCK_AUTH=false

# Next.js runtime
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
