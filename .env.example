# YiJian frontend environment
# Copy to .env.local for local development, or pass as Docker build args.

# Browser-visible Squid API base URL.
# Use /api when a reverse proxy routes /api to Squid.
NEXT_PUBLIC_API_URL=/api

# Must match Squid CLIENT_PASSWORD_HASH_ENABLED.
NEXT_PUBLIC_PASSWORD_HASH_ENABLED=false

# Next.js runtime
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
